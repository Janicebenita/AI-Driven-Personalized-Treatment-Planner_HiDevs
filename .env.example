# Optional. Never commit a real key. With neither setting, the app uses transparent rules-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=
PORT=3000
# HiDevs preferred provider. Configure locally; never paste keys into chat.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional synthetic session history; never required to generate a plan.
MONGODB_URI=
MONGODB_DATABASE=careweave
# Chroma first. Set faiss only after a Chroma compatibility failure.
VECTOR_BACKEND=chroma
# Pin embedding configuration. Custom models require their own commit SHA.
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
CHUNK_TOKENS=180
CHUNK_OVERLAP_TOKENS=30
